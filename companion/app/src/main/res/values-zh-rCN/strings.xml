    <string name="optimize_restore">恢复上次备份</string>
    <string name="optimize_backup_note">只停用，不卸载，也不用 root。</string>
    <string name="optimize_confirm_title">停用 %1$d 个包？</string>
    <string name="optimize_confirm_message">会先备份当前已停用列表，并跳过 Android 核心包。</string>
    <string name="optimize_running">正在停用……第 %1$d / %2$d 个</string>
    <string name="optimize_done">完成：停用 %1$d 个，跳过 %2$d 个，失败 %3$d 个。</string>
    <string name="optimize_no_packages">清单里没有合法的包名。</string>
