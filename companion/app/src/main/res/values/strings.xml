    <string name="optimize_title">Optimize</string>
    <string name="optimize_intro">Paste a debloat list — one package per line, comments with #. Packages Android needs are skipped and never sent to the TV. The list of currently disabled packages is saved on this phone before the first change, and “Restore last backup” enables exactly those again.</string>
    <string name="optimize_paste_hint">com.example.bloat\ncom.example.telemetry</string>
    <string name="optimize_apply">Apply list</string>
    <string name="optimize_restore">Restore last backup</string>
    <string name="optimize_backup_note">Disable only. Nothing is uninstalled, and root is never used.</string>
    <string name="optimize_confirm_title">Disable %1$d packages?</string>
    <string name="optimize_confirm_message">The current disabled list is backed up first. Core Android packages are skipped.</string>
